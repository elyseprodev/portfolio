# ---------------------------------------------------------------------------
# ELYSE DEV — environment template
# Copy to `.env` (root) and fill in the values you actually have.
# NEVER commit a filled-in `.env` file.
# ---------------------------------------------------------------------------

# --- server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000

# --- database ---------------------------------------------------------------
# MongoDB connection string. Leave EMPTY to run on the local JSON store
# (development fallback that persists to database/.data/*.json).
MONGODB_URI=
MONGODB_DB=elyse_dev

# --- optional integrations --------------------------------------------------
# Fine-grained GitHub token (no scopes needed for public data).
# Without it the GitHub page falls back to the curated static repository list
# and public, unauthenticated rate limits apply.
GITHUB_TOKEN=
# Optional: your GitHub username overrides the default profile.
GITHUB_USERNAME=ElissaElyse7

# --- notifications ----------------------------------------------------------
# Contact messages are always stored in the database. Email notification is
# OPTIONAL: without these values the API honestly reports
# `notification: "not-configured"` instead of pretending an email was sent.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=
CONTACT_NOTIFY_FROM=onboarding@resend.dev

# --- client (build/runtime public config) -----------------------------------
NEXT_PUBLIC_SITE_URL=
