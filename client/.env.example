# ---------------------------------------------------------------------------
# ELYSE DEV — client environment (copy to client/.env.local)
# ---------------------------------------------------------------------------

# Where the Next.js server finds the Express API.
# Server-only: this is NEVER exposed to the browser bundle.
API_URL=http://127.0.0.1:4000

# How long to wait for the API before falling back to bundled content (ms).
API_REQUEST_TIMEOUT_MS=2500

# Public production domain. Only set this when the domain is real — it enables
# canonical URLs, absolute Open Graph URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=
